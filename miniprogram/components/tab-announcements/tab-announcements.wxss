/* Compose: textarea above, audience + send below (the phone website's layout) */
.ann-compose { background: var(--gray-100); border-radius: 16px; padding: 10px 12px 12px; margin-bottom: 12px; }
.ann-text { width: 100%; height: 86px; font-size: 15px; line-height: 1.5; color: var(--gray-900); padding: 6px 0; }
.ann-side { display: flex; gap: 8px; align-items: center; }
.ann-side picker { flex: 1; }
.ann-select { height: 40px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px 0 14px; border-radius: 20px; background: var(--surface); font-size: 14px; color: var(--gray-800); }
.ann-select-disabled { flex: 1; color: var(--gray-500); }
.ann-send { height: 40px; min-height: 40px; padding: 0 18px; }
.ann-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px; }
.ann-meta { gap: 6px; }
.ann-actions { display: flex; gap: 4px; margin-left: auto; }
.ann-act { display: flex; align-items: center; gap: 4px; height: 30px; padding: 0 10px; border-radius: 15px; font-size: 13px; font-weight: 500; color: var(--primary); }
.ann-act-danger { color: var(--danger); }
