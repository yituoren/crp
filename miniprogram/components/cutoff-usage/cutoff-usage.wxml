<view wx:if="{{show}}" class="card">
  <view class="card-header">熔断使用情况</view>
  <view class="lc-list">
    <view wx:for="{{rows}}" wx:key="id" class="lc">
      <view class="lc-f full"><text class="lc-v cu-team">{{item.label}}</text></view>
      <view wx:for="{{item.cells}}" wx:for-item="c" wx:key="id" class="lc-f"><text class="lc-k">{{c.name}}</text><text class="lc-v">{{c.text}}</text></view>
      <view wx:if="{{isHost}}" class="lc-f actions"><view class="lc-btn" data-id="{{item.id}}" bindtap="edit">修改记录</view></view>
    </view>
  </view>
</view>

<block wx:if="{{editing}}">
  <view class="sheet-scrim" bindtap="close" catchtouchmove="noop"></view>
  <view class="sheet">
    <view class="sheet-title">{{editing.title}}</view>
    <view wx:if="{{!uses.length}}" class="empty-rows">暂无记录</view>
    <view wx:else class="lc-list">
      <view wx:for="{{uses}}" wx:key="id" class="lc">
        <view class="lc-f"><text class="lc-k">时间</text><text class="lc-v">{{item.time}}</text></view>
        <view class="lc-f"><text class="lc-k">种类</text><text class="lc-v">{{item.name}}</text></view>
        <view class="lc-f"><text class="lc-k">操作人</text><text class="lc-v">{{item.by}}</text></view>
        <view wx:if="{{!item.locked}}" class="lc-f actions"><view class="lc-btn cu-danger" data-id="{{item.id}}" bindtap="remove"><icon-m name="delete" size="16" color="#b3261e" />删除</view></view>
      </view>
    </view>
    <view class="sheet-actions"><button class="btn btn-text" bindtap="close">关闭</button></view>
  </view>
</block>
