<view class="card {{flat ? 'flat' : ''}}">
  <view class="card-header">
    <text>{{title}}</text>
    <picker wx:if="{{showTeamPick && canAdd && !pending && !finished}}" range="{{teamOptions}}" value="{{teamIndex < 0 ? 0 : teamIndex}}" bindchange="pickTeam">
      <view class="pp-team {{teamIndex >= 0 ? '' : 'ph'}}">{{teamIndex >= 0 ? teamOptions[teamIndex] : '选择队伍'}}<icon-m name="expand_more" size="18" color="#444746" /></view>
    </picker>
  </view>
  <view wx:if="{{!canAdd && !pending && !finished}}" class="text-sm text-gray mb-2">主办、本赛段站点可操作所有队伍，跟队只能操作所跟队伍</view>
  <view wx:if="{{pending}}" class="alert alert-warning">赛段尚未开始，开始赛段后才能操作罚时。</view>
  <view wx:elif="{{finished}}" class="alert">赛段已结束，罚时记录已锁定，只有管理员可以修改。</view>
  <view wx:elif="{{canAdd}}" class="form-grid mb-2">
    <picker wx:if="{{!legId}}" class="full" range="{{legOptions}}" value="{{legIndex < 0 ? 0 : legIndex}}" bindchange="pickLeg">
      <view class="field {{legIndex >= 0 ? '' : 'ph'}}">{{legIndex >= 0 ? legOptions[legIndex] : '选择环节'}}<icon-m name="expand_more" size="18" color="#444746" /></view>
    </picker>
    <input class="field" type="number" value="{{minutes}}" data-field="minutes" bindinput="onInput" placeholder="分钟" />
    <input class="field full" value="{{reason}}" data-field="reason" bindinput="onInput" placeholder="原因（如：打车超预算 / 站点失误耽误）" />
    <button class="btn btn-danger-tonal" hover-class="btn-hover" bindtap="add">增加罚时</button>
    <button class="btn btn-tonal" hover-class="btn-hover" bindtap="credit">补充时间</button>
  </view>

  <view wx:if="{{!rows.length}}" class="empty-rows">暂无记录</view>
  <view wx:else class="lc-list">
    <view wx:for="{{rows}}" wx:key="id" class="lc {{item.reverted ? 'reverted' : ''}}">
      <view class="lc-f"><text class="lc-k">时间</text><text class="lc-v">{{item.time}}</text></view>
      <view class="lc-f"><text class="lc-k">队伍</text><text class="lc-v">{{item.team}}</text></view>
      <view class="lc-f full"><text class="lc-k">环节</text><view class="lc-v pp-leg"><leg-tag wx:if="{{item.legType}}" type="{{item.legType}}" /><text>{{item.legName}}</text></view></view>
      <view class="lc-f"><text class="lc-k">类型</text><text class="lc-v {{item.penalty ? 'neg' : 'pos'}}">{{item.penalty ? '罚时' : '补时'}}</text></view>
      <view class="lc-f"><text class="lc-k">时长</text><text class="lc-v {{item.penalty ? 'neg' : 'pos'}}">{{item.amount}}</text></view>
      <view class="lc-f"><text class="lc-k">净罚时</text><text class="lc-v">{{item.net}}</text></view>
      <view class="lc-f"><text class="lc-k">操作人</text><text class="lc-v">{{item.by}}</text></view>
      <view class="lc-f full"><text class="lc-k">原因</text><text class="lc-v">{{item.reason}}</text></view>
      <view wx:if="{{item.reverted || item.canRevert}}" class="lc-f actions">
        <text wx:if="{{item.reverted}}" class="text-xs text-gray">{{item.revertedBy}}撤销</text>
        <view wx:else class="lc-btn" data-id="{{item.id}}" bindtap="revert"><icon-m name="undo" size="16" color="#0b57d0" />撤销</view>
      </view>
    </view>
  </view>
</view>
