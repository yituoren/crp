<view class="card">
  <view class="card-header">{{title}}</view>
  <view wx:if="{{!canAdd && !pending && !finished}}" class="text-sm text-gray mb-2">主办、本赛段站点可操作所有队伍，跟队只能操作所跟队伍</view>
  <view wx:if="{{pending}}" class="alert alert-warning">赛段尚未开始，开始赛段后才能操作罚时。</view>
  <view wx:elif="{{finished}}" class="alert">赛段已结束，罚时记录已锁定，只有管理员可以修改。</view>
  <view wx:elif="{{canAdd}}" class="pf">
    <picker wx:if="{{showTeamPick}}" range="{{teamOptions}}" value="{{teamIndex}}" bindchange="pickTeam">
      <view class="pf-select">{{teamIndex >= 0 ? teamOptions[teamIndex] : '选择队伍'}}<icon-m name="expand_more" size="18" color="#444746" /></view>
    </picker>
    <picker wx:if="{{!legId}}" range="{{legOptions}}" value="{{legIndex}}" bindchange="pickLeg">
      <view class="pf-select {{legIndex >= 0 ? '' : 'placeholder'}}">{{legIndex >= 0 ? legOptions[legIndex] : '选择环节'}}<icon-m name="expand_more" size="18" color="#444746" /></view>
    </picker>
    <view class="pf-row">
      <input class="pf-input pf-min" type="number" value="{{minutes}}" data-field="minutes" bindinput="onInput" placeholder="分钟" />
      <input class="pf-input pf-reason" value="{{reason}}" data-field="reason" bindinput="onInput" placeholder="原因（如：打车超预算）" />
    </view>
    <view class="pf-row">
      <button class="btn btn-danger-tonal pf-btn" hover-class="btn-hover" bindtap="add">增加罚时</button>
      <button class="btn btn-tonal pf-btn" hover-class="btn-hover" bindtap="credit">补充时间</button>
    </view>
  </view>

  <view wx:if="{{!rows.length}}" class="empty-rows">暂无记录</view>
  <view wx:for="{{rows}}" wx:key="id" class="pr {{item.reverted ? 'reverted' : ''}}">
    <view class="flex-between">
      <view class="flex pr-head">
        <text class="badge {{item.penalty ? 'badge-danger' : 'badge-success'}}">{{item.penalty ? '罚时' : '补时'}}</text>
        <text class="pr-amount {{item.penalty ? 'neg' : 'pos'}}">{{item.amount}}</text>
        <text class="pr-team">{{item.team}}</text>
      </view>
      <text wx:if="{{item.reverted}}" class="text-xs text-gray">{{item.revertedBy}}撤销</text>
      <view wx:elif="{{item.canRevert}}" class="pr-revert" data-id="{{item.id}}" bindtap="revert"><icon-m name="undo" size="16" color="#0b57d0" />撤销</view>
    </view>
    <view class="pr-line"><leg-tag wx:if="{{item.legType}}" type="{{item.legType}}" /><text>{{item.legName}}</text></view>
    <view class="pr-line text-gray">{{item.reason}}</view>
    <view class="pr-line text-xs text-gray">{{item.time}} · {{item.by}} · 净罚时 {{item.net}}</view>
  </view>
</view>
