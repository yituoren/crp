.pp-team { height: 36px; display: flex; align-items: center; gap: 4px; padding: 0 10px 0 14px; border-radius: 18px; background: var(--field); font-size: 14px; font-weight: 400; color: var(--gray-900); }
.pp-team.ph { color: var(--gray-500); }
.pp-leg { display: flex; align-items: center; gap: 4px; justify-content: flex-end; }
.neg { color: var(--danger); font-weight: 500; }
.pos { color: var(--success); font-weight: 500; }
