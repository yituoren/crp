/* Bag tiles: two columns on phones (the website's .bag-grid) */
.bag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.bag-tile { display: flex; align-items: center; gap: 8px; height: 48px; padding: 0 12px 0 10px; border-radius: 12px; background: var(--field); color: var(--gray-900); border: 1px solid transparent; min-width: 0; }
.bag-tile.on { background: var(--primary-light); color: var(--primary-on-light); }
.bag-tile.off { color: var(--gray-500); }
.bag-check { width: 18px; height: 18px; border-radius: 9px; border: 1.5px solid var(--gray-400); display: flex; align-items: center; justify-content: center; flex: none; }
.bag-tile.on .bag-check { background: var(--primary); border-color: var(--primary); }
.bag-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
.bag-count { font-size: 12px; color: var(--gray-500); font-variant-numeric: tabular-nums; }
.bag-tile.on .bag-count { color: var(--primary-on-light); }
.bag-actions { display: flex; align-items: center; justify-content: space-between; margin: 10px 0 4px; }
.bag-log { margin-top: 12px; }
.bag-field { margin-bottom: 10px; }
.bag-label { font-size: 13px; color: var(--gray-700); margin: 0 0 6px 4px; }
