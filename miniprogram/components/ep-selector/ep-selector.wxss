.ep-selector { margin-bottom: 10px; white-space: nowrap; }
.ep-row { display: inline-flex; gap: 8px; padding-bottom: 2px; }
.ep-btn { flex: none; display: inline-flex; align-items: center; padding: 0 14px; height: 36px; border-radius: 18px; border: 1px solid var(--gray-300); color: var(--gray-700); font-size: 14px; font-weight: 500; }
.ep-btn.active { background: var(--primary-light); border-color: var(--primary-light); color: var(--primary-on-light); }
.ep-btn.done { color: var(--gray-500); border-color: var(--gray-200); background: var(--gray-100); }
.ep-btn.done.active { color: var(--primary-on-light); border-color: var(--primary-light); background: var(--primary-light); opacity: .8; }
.ep-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); margin-left: 6px; }
