.bag-tile { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 6px 10px; margin-bottom: 8px; border-radius: 12px; background: var(--field); }
.bag-tile.on { background: var(--primary-light); color: var(--primary-on-light); }
.bag-tile.off { opacity: .5; }
.bag-check { width: 18px; height: 18px; border-radius: 9px; border: 1.5px solid var(--gray-400); display: flex; align-items: center; justify-content: center; font-size: 12px; color: #fff; flex: none; }
.bag-tile.on .bag-check { background: var(--primary); border-color: var(--primary); }
.bag-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.bag-name { font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bag-info { font-size: 12px; color: var(--gray-500); }
.bag-tile.on .bag-info { color: var(--primary-on-light); }
.shop-qty { display: flex; align-items: center; gap: 4px; visibility: hidden; }
.shop-qty.show { visibility: visible; }
.shop-step { width: 30px; height: 30px; border-radius: 15px; background: rgba(255, 255, 255, .7); display: flex; align-items: center; justify-content: center; }
.shop-step.dis { opacity: .4; }
.shop-num { min-width: 20px; text-align: center; font-weight: 600; }
.shop-actions { align-items: center; }
.shop-total { margin-right: auto; }
