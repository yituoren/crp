.tc-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
.team-card { background: var(--surface); border: 1px solid var(--gray-200); border-radius: 12px; padding: 14px 16px; }
.team-card-hover { background: var(--paper); }
.team-eliminated, .team-withdrawn { opacity: .55; background: var(--gray-100); }
.tc-name { font-weight: 600; color: var(--gray-900); }
.tc-status { font-size: 12px; color: var(--danger); font-weight: 500; }
.currency-box { font-size: 24px; font-weight: 600; color: var(--warning); font-variant-numeric: tabular-nums; }
.bag-items { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; margin-top: 8px; min-height: 22px; }
.bag-item { display: inline-flex; align-items: center; gap: 3px; padding: 0 8px; height: 22px; border-radius: 8px; background: var(--chip); font-size: 12px; color: var(--gray-700); }
.bag-item-n { color: var(--gray-500); }
.bag-empty { font-size: 12px; line-height: 22px; color: var(--gray-500); }
.tc-filter { height: 36px; display: flex; align-items: center; gap: 4px; padding: 0 10px 0 14px; border-radius: 18px; background: var(--field); font-size: 14px; font-weight: 400; color: var(--gray-900); }
