<view class="rc-list">
  <view wx:for="{{rows}}" wx:key="key" class="rc {{item.dim ? 'dim' : ''}}">
    <view class="rc-title"><leg-tag wx:if="{{item.legType}}" type="{{item.legType}}" /><text class="rl-name">{{item.title}}</text></view>
    <view class="lc-f"><text class="lc-k">状态</text><text class="lc-v">{{item.state}}</text></view>
    <view class="lc-f"><text class="lc-k">{{item.startLabel}}</text><text class="lc-v rl-t {{item.startHit ? 'hit' : ''}}">{{item.start}}</text></view>
    <view class="lc-f"><text class="lc-k">{{item.endLabel}}</text><text class="lc-v rl-t {{item.endHit ? 'hit' : ''}}">{{item.end}}</text></view>
    <view wx:if="{{item.extra}}" class="lc-f full">
      <text class="lc-k">{{item.extra.label}}</text>
      <picker wx:if="{{item.extra.inline}}" range="{{item.extra.labels}}" value="{{item.extra.index < 0 ? 0 : item.extra.index}}" data-key="{{item.key}}" bindchange="pickExtra">
        <view class="rl-select">{{item.extra.labels[item.extra.index]}}<icon-m name="expand_more" size="16" color="#444746" /></view>
      </picker>
      <text wx:else class="lc-v">{{item.extra.text}}</text>
    </view>
    <view wx:if="{{item.action}}" class="rl-action">
      <text wx:if="{{item.action.type === 'locked'}}" class="text-gray text-sm" data-key="{{item.key}}" bindtap="act">已锁定</text>
      <button wx:else class="btn btn-sm {{item.action.text ? 'btn-text' : ''}} {{item.action.success ? 'btn-success' : ''}} {{item.action.disabled ? 'btn-off' : ''}}" data-key="{{item.key}}" bindtap="act">{{item.action.label}}</button>
    </view>
  </view>
</view>
