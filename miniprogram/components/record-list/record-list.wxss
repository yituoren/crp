.rl-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rl-t { font-variant-numeric: tabular-nums; }
.hit { color: #d93025; font-weight: 600; }
.rl-select { height: 32px; display: flex; align-items: center; gap: 4px; padding: 0 8px 0 12px; border-radius: 16px; background: var(--field); font-size: 13px; }
/* the action spans the card, its button fills the row */
.rl-action { grid-column: 1 / -1; display: flex; justify-content: flex-end; margin-top: 6px; }
.rl-action .btn { width: 100% !important; min-height: 36px; }
.btn-off { background: var(--gray-200) !important; color: var(--gray-500) !important; }
