.ts-actions { display: flex; gap: 8px; margin-bottom: 10px; }
.ts-scroll { white-space: nowrap; border-top: 2px solid var(--gray-300); border-bottom: 2px solid var(--gray-300); background: var(--surface); }
.ts-table { display: inline-flex; flex-direction: column; min-width: 100%; }
.ts-row { display: flex; align-items: stretch; border-bottom: 1px solid var(--gray-200); }
.ts-row:last-child { border-bottom: none; }
.ts-head { background: var(--gray-100); font-size: 12px; font-weight: 500; color: var(--gray-500); }
.ts-c { flex: none; display: flex; align-items: center; gap: 6px; padding: 8px; font-size: 13px; white-space: normal; }
/* the first column stays put while the rest scrolls */
.ts-name { width: 88px; position: sticky; left: 0; z-index: 1; background: var(--paper); border-right: 1px solid var(--gray-200); word-break: break-all; }
.ts-head .ts-name { background: var(--gray-100); }
.ts-role { width: 72px; justify-content: center; }
.ts-detail { width: 160px; flex-direction: column; align-items: flex-start; justify-content: center; gap: 4px; }
.ts-edit { width: 268px; }
.ts-leg { display: flex; align-items: center; gap: 4px; }
.ts-sel { height: 34px; display: flex; align-items: center; justify-content: space-between; gap: 4px; padding: 0 8px 0 12px; border-radius: 17px; background: var(--field); font-size: 13px; color: var(--gray-900); width: 152px; }
.ts-sel-role { width: 92px; }
.ts-sel.ph { color: var(--gray-500); }
.ts-ell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.ts-none { width: 152px; }
.badge-live { background: var(--warning-light); color: var(--warning-on-light); }
.strong { font-weight: 600; color: var(--gray-900); }
.ts-notes { margin-top: 10px; }
.ts-pick { display: flex; align-items: center; gap: 8px; height: 48px; padding: 0 12px; border-radius: 12px; margin-bottom: 6px; background: var(--field); }
.ts-pick.on { background: var(--primary-light); }
.ts-check { width: 18px; height: 18px; border-radius: 4px; border: 1.5px solid var(--gray-400); display: flex; align-items: center; justify-content: center; flex: none; }
.ts-pick.on .ts-check { background: var(--primary); border-color: var(--primary); }
