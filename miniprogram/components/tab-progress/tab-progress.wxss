/* The website's progress matrix (.mx2), phone sizes: header 40 + 28, rows 44 */
.card-table { padding-left: 0; padding-right: 0; }
.card-table .card-header { padding: 0 14px; }
.mx { display: flex; border-top: 2px solid var(--gray-300); border-bottom: 2px solid var(--gray-300); }
.mx-left { width: 104px; flex: none; border-right: 2px solid var(--gray-300); }
.mx-team-head { height: 68px; display: flex; align-items: center; padding: 0 8px; background: var(--gray-100); font-weight: 500; color: var(--gray-500); font-size: 13px; border-bottom: 1px solid var(--gray-200); }
.mx-team { height: 44px; padding: 0 8px; display: flex; flex-direction: column; justify-content: center; background: #e6f4ea; border-bottom: 1px solid var(--gray-200); }
.mx-team-line { display: flex; align-items: center; gap: 4px; min-width: 0; }
.mx-team-name { font-weight: 600; font-size: 13px; color: var(--gray-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.mx-team-sub { font-size: 11px; color: var(--gray-500); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mx-rank { font-size: 12px; font-weight: 600; color: var(--gray-500); font-variant-numeric: tabular-nums; flex: none; }
.rank-1 { color: #9a6700; }
.rank-2 { color: #6b6761; }
.rank-3 { color: #8a4b1f; }
.mx-right { flex: 1; min-width: 0; white-space: nowrap; }
.mx-grid { display: flex; flex-direction: column; }
.mx-hrow { display: flex; height: 40px; background: var(--gray-100); border-bottom: 1px solid var(--gray-200); }
.mx-hrow-sub { height: 28px; }
.mx-leg { flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; overflow: hidden; white-space: nowrap; font-size: 13px; color: var(--gray-900); }
.mx-leg-name { overflow: hidden; text-overflow: ellipsis; }
.mx-leg-sep { color: var(--gray-400); }
.mx-sub { flex: none; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 500; color: var(--gray-500); }
.mx-sub.branch { font-size: 11px; color: var(--gray-600); }
.mx-row { display: flex; height: 44px; border-bottom: 1px solid var(--gray-200); }
.mx-row:last-child, .mx-team:last-child { border-bottom: none; }
.mx-cell { flex: none; display: flex; align-items: center; justify-content: center; font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; }
.mx-first { border-left: 2px solid var(--gray-300); }
.mx-leg.mx-first:first-child, .mx-sub.mx-first:first-child, .mx-cell.mx-first:first-child { border-left: none; }
/* Cell backgrounds by kind; running cells amber; blanks white */
.k-time, .k-dur, .k-extra { background: #e6f4ea; }
.blank { background: #ffffff; color: var(--gray-500); }
.done { color: #137333; }
.arrived { background: #fef7e0 !important; color: #b06000; }
.hit { color: #d93025 !important; font-weight: 600; }
.branch { font-size: 12px; }
.k-extra { font-size: 12px; }
