<block wx:if="{{show}}">
  <view class="sheet-scrim" bindtap="close" catchtouchmove="noop"></view>
  <view class="sheet" catchtouchmove="noop">
    <view class="sheet-title es-title">{{title}}</view>
    <view class="es-field">
      <view class="es-label">开始时间<text class="text-gray es-hint">（默认 = 上一环节的结束时间，留空 = 未开始）</text></view>
      <dt-field value="{{form.arrivedAt}}" clearable data-field="arrivedAt" bind:change="setTime" />
    </view>
    <view class="es-field">
      <view class="es-label">{{label}}时间<text class="text-gray es-hint">（留空 = 未{{label}}；改动会同步为下一环节的开始时间）</text></view>
      <dt-field value="{{form.completedAt}}" clearable data-field="completedAt" bind:change="setTime" />
    </view>
    <view wx:if="{{type === 'UT' || type === 'YD' || type === 'Union'}}" class="es-field">
      <view class="es-label">{{type === 'Union' ? '合作队伍' : '施加对象'}}</view>
      <picker range="{{targetOptions}}" value="{{targetIndex < 0 ? 0 : targetIndex}}" bindchange="pickTarget"><view class="es-select">{{targetOptions[targetIndex]}}<icon-m name="expand_more" size="18" color="#444746" /></view></picker>
    </view>
    <view wx:if="{{type === 'DT'}}" class="es-field">
      <view class="es-label">绕道选择</view>
      <picker range="{{detourOptions}}" bindchange="pickDetour"><view class="es-select">{{form.detourChoice || '未选'}}<icon-m name="expand_more" size="18" color="#444746" /></view></picker>
    </view>
    <view wx:if="{{type === 'RB'}}" class="es-field">
      <view class="es-label">路障完成人</view>
      <picker range="{{memberOptions}}" bindchange="pickMember"><view class="es-select">{{form.roadblockBy || '未选'}}<icon-m name="expand_more" size="18" color="#444746" /></view></picker>
    </view>
    <view wx:if="{{type === 'FF'}}" class="es-field">
      <view class="es-label">快进结果</view>
      <picker range="{{['未尝试', '成功', '失败']}}" bindchange="pickFf"><view class="es-select">{{form.ffResult === 'success' ? '成功' : form.ffResult === 'fail' ? '失败' : '未尝试'}}<icon-m name="expand_more" size="18" color="#444746" /></view></picker>
    </view>
    <view class="es-field">
      <view class="es-label">备注</view>
      <textarea class="es-note" value="{{form.note}}" maxlength="1000" bindinput="onNote" />
    </view>
    <view class="sheet-actions">
      <button class="btn btn-text" bindtap="close">取消</button>
      <button class="btn" bindtap="save">保存</button>
    </view>
  </view>
</block>
