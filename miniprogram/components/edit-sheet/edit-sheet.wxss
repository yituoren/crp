.es-title { font-size: 18px; }
.es-field { margin-bottom: 12px; }
.es-label { font-size: 13px; color: var(--gray-700); margin-bottom: 6px; }
.es-label text { font-size: 12px; }
.es-select { height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px 0 16px; border-radius: 22px; background: var(--field); font-size: 15px; }
.es-note { width: 100%; height: 64px; padding: 10px 16px; border-radius: 16px; background: var(--field); font-size: 15px; }
