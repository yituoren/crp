/* The website's .my-work: sections 16px apart, cards without their own margin (flat) */
.my-work { display: flex; flex-direction: column; gap: 16px; }
.my-head { font-size: 14px; color: var(--gray-700); line-height: 1.8; }
.strong { font-weight: 600; color: var(--gray-900); }
.money { color: var(--warning); }
.badge-follow { background: var(--primary-light); color: var(--primary-on-light); }
.badge-station { background: var(--success-light); color: var(--success-on-light); }
.badge-live { background: var(--warning-light); color: var(--warning-on-light); }
.link { color: var(--primary); font-weight: 500; margin-left: 8px; }
.hint { display: flex; justify-content: space-between; align-items: center; }
.section-title { display: flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 600; color: var(--gray-900); }
.station-leg { display: flex; flex-direction: column; gap: 12px; }
.station-leg .alert { margin-bottom: 0; }
.station-leg + .station-leg { border-top: 1px solid var(--gray-200); padding-top: 16px; }
.empty-state { white-space: pre-line; }
