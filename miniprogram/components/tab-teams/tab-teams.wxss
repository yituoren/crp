.tt-actions { display: flex; gap: 8px; margin-bottom: 6px; }
.tt-tip { margin: 0 2px 10px; }
.tt-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
.team-card { background: var(--surface); border: 1px solid var(--gray-200); border-radius: 12px; padding: 14px 16px; }
.team-eliminated, .team-withdrawn { opacity: .55; background: var(--gray-100); }
.tt-name { font-weight: 500; font-size: 16px; color: var(--gray-900); }
.status-alive { color: var(--success); font-size: 13px; font-weight: 500; }
.status-eliminated, .status-withdrawn { color: var(--danger); font-size: 13px; font-weight: 500; }
.tt-btns { display: flex; align-items: center; gap: 4px; margin-top: 10px; }
.tt-btn { display: flex; align-items: center; gap: 4px; height: 32px; padding: 0 10px; border-radius: 16px; font-size: 13px; font-weight: 500; color: var(--primary); }
.tt-btn.danger { color: var(--danger); }
