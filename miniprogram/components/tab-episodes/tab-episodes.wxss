.te-add-ep { display: flex; justify-content: flex-end; margin: -4px 0 6px; }
.te-link { display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 500; color: var(--primary); padding: 4px 6px; }
/* Episode header buttons: two equal columns (the phone website's .ep-actions) */
.ep-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px; }
.ep-actions .btn { width: 100% !important; }
.te-danger { color: var(--danger) !important; }
.te-head { min-height: 32px; margin: 4px 2px 6px; }
.section-title { font-size: 16px; font-weight: 600; color: var(--gray-900); }
.te-tip { margin: 0 2px 8px; }
.te-legs { display: grid; grid-template-columns: 1fr; gap: 10px; }
.leg-item { background: var(--surface); border: 1px solid var(--gray-200); border-radius: 12px; padding: 12px 14px; }
.leg-item-hover { background: var(--paper); }
.te-leg-head { min-height: 32px; margin-bottom: 4px; }
.te-del { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; margin-right: -6px; }
.te-leg-name { font-weight: 500; font-size: 15px; color: var(--gray-900); }
.te-short { width: 200px; }
.te-label { font-size: 13px; color: var(--gray-700); margin: 10px 4px 6px; }
.te-elim { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-size: 14px; }
.te-count { width: 52px; height: 32px; text-align: center; border-radius: 8px; background: var(--field); }
.te-notes { width: 100%; height: 80px; padding: 10px 16px; border-radius: 16px; background: var(--field); font-size: 15px; }
