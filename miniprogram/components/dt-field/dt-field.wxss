.dt { display: flex; align-items: center; gap: 8px; }
.dt-part { height: 44px; display: flex; align-items: center; padding: 0 14px; border-radius: 22px; background: var(--field); font-size: 16px; color: var(--gray-900); font-variant-numeric: tabular-nums; }
.dt-time { min-width: 108px; justify-content: center; }
.dt-part.ph { color: var(--gray-500); }
.dt-clear { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 18px; }
