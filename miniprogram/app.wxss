/* Material 3, the same tokens as the website (web/src/styles.css, mobile layout in web/src/mobile.css) */
page {
  --primary: #0b57d0; --primary-light: #d3e3fd; --primary-on-light: #041e49; --primary-soft: #e8f0fe;
  --danger: #b3261e; --danger-light: #f9dedc; --danger-on-light: #410e0b;
  --success: #1e8e3e; --success-light: #c4eed0; --success-on-light: #0d652d;
  --warning: #b06000; --warning-light: #feefc3; --warning-on-light: #5c3a00;
  --paper: #f8f9fa; --surface: #ffffff; --chip: #e8edf3; --field: #f1f3f4;
  --gray-100: #f1f3f4; --gray-200: #e3e3e3; --gray-300: #c4c7c5; --gray-400: #9aa0a6;
  --gray-500: #5f6368; --gray-600: #444746; --gray-700: #3c4043; --gray-800: #1f1f1f; --gray-900: #202124;
  background: var(--paper);
  color: var(--gray-800);
  font-size: 14px;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}
view, text, input, textarea, button { box-sizing: border-box; }

/* Cards */
.card { background: var(--surface); border-radius: 14px; padding: 14px 14px 12px; margin-bottom: 10px; }
.card-header { display: flex; align-items: center; justify-content: space-between; font-size: 15px; font-weight: 500; color: var(--gray-900); margin-bottom: 10px; min-height: 28px; }

/* Buttons: filled / tonal / text pills. WeChat's button has a fixed 184px width and auto side margins: undo them */
.btn { width: auto !important; margin: 0 !important; display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 22px; border-radius: 22px; background: var(--primary); color: #fff; font-size: 15px; font-weight: 500; line-height: 1; border: none; }
.btn::after { border: none; }
.btn-block { display: flex; width: 100% !important; }
.btn-tonal { background: var(--primary-light); color: var(--primary-on-light); }
.btn-text { background: transparent; color: var(--primary); padding: 0 12px; }
.btn-sm { min-height: 36px; padding: 0 16px; font-size: 14px; border-radius: 18px; }
.btn[disabled] { background: var(--gray-200) !important; color: var(--gray-400) !important; }
.btn-hover { opacity: .88; }
.icon-btn { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 24px; flex: none; }
.icon-btn-hover { background: rgba(68, 71, 70, .08); }

/* Form fields: filled pills with the label inside (as on the phone website) */
.form-group { position: relative; background: var(--field); border-radius: 28px; margin-bottom: 12px; padding: 8px 20px 6px; }
.form-group .label { font-size: 12px; color: var(--gray-600); line-height: 1.4; }
.form-group input { height: 30px; font-size: 16px; color: var(--gray-900); }
.form-error { min-height: 20px; color: var(--danger); font-size: 13px; text-align: center; margin: 8px 0; }

/* Badges / chips */
.badge { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 11px; font-size: 12px; font-weight: 500; background: var(--chip); color: var(--gray-700); white-space: nowrap; }
.badge-info { background: var(--primary-light); color: var(--primary-on-light); }
.badge-success { background: var(--success-light); color: var(--success-on-light); }
.badge-warning { background: var(--warning-light); color: var(--warning-on-light); }
.badge-danger { background: var(--danger-light); color: var(--danger-on-light); }

/* Text helpers */
.text-gray { color: var(--gray-500); }
.text-sm { font-size: 13px; }
.text-xs { font-size: 12px; }
.empty-state { text-align: center; color: var(--gray-500); padding: 40px 16px; font-size: 14px; }

/* Alerts */
.alert { border-radius: 12px; padding: 10px 12px; font-size: 13px; margin-bottom: 10px; background: var(--primary-soft); color: var(--primary-on-light); }
.alert-warning { background: var(--warning-light); color: var(--warning-on-light); }
.alert-danger { background: var(--danger-light); color: var(--danger-on-light); }

/* Bottom sheet (the phone website's dialogs) */
.sheet-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .32); z-index: 500; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 510; background: var(--surface); border-radius: 28px 28px 0 0; padding: 20px 20px calc(16px + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 20px; font-weight: 500; color: var(--gray-900); margin-bottom: 14px; }
.sheet-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }

/* Loading */
.loading { display: flex; justify-content: center; padding: 48px 0; }
.spinner { width: 28px; height: 28px; border-radius: 50%; border: 3px solid var(--primary-light); border-top-color: var(--primary); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Leg type tags (the same colours as the website) */
.tag { display: inline-block; padding: 2px 7px; border-radius: 6px; font-size: 11px; font-weight: 600; letter-spacing: .3px; color: #fff; background: var(--gray-500); white-space: nowrap; line-height: 1.5; }
.tag-SL { background: #C9DA4D; color: #2B3300; }
.tag-RI { background: #009DDA; }
.tag-TI { background: #33CBCC; color: #063D3E; }
.tag-DT { background: #EAAA16; color: #3A2A00; }
.tag-RB { background: #AC0000; }
.tag-FF { background: #27CE62; color: #063A18; }
.tag-Union { background: #EB661C; }
.tag-FO { background: #664193; }
.tag-SB { background: #FFCC01; color: #3D3000; }
.tag-Trap { background: #7B4E33; }
.tag-SQ { background: #BF1463; }
.tag-Shuffle { background: #6618CC; }
.tag-UT { background: #78716C; }
.tag-YD { background: #0E7490; }
.tag-PS { background: #1E293B; }

/* Layout helpers */
.flex { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.flex-between { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.pre { white-space: pre-wrap; word-break: break-word; }
.mt-1 { margin-top: 6px; }
.mb-2 { margin-bottom: 12px; }
