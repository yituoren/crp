/* The phone website's shell (web/src/mobile.css) */
.m-title { flex: 1; min-width: 0; font-size: 18px; font-weight: 500; color: var(--gray-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-left: 4px; }
.m-toggle { height: 32px; width: 80px; display: flex; align-items: center; justify-content: center; gap: 4px; border-radius: 16px; background: var(--field); color: var(--gray-800); font-size: 13px; font-weight: 500; flex: none; }
.m-toggle.on { background: var(--primary-light); color: var(--primary-on-light); }
.m-offline { display: flex; align-items: center; padding: 0 6px; }
.sync-dot { width: 8px; height: 8px; border-radius: 4px; background: var(--danger); }
.m-body { padding: 4px 12px calc(76px + env(safe-area-inset-bottom)); }

/* Bottom navigation (Material 3 navigation bar) */
.m-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: flex; align-items: stretch; height: calc(64px + env(safe-area-inset-bottom)); padding: 0 4px env(safe-area-inset-bottom); background: var(--surface); box-shadow: 0 -1px 0 var(--gray-200); }
.m-nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: var(--gray-600); font-size: 11px; font-weight: 500; }
.m-nav-ic { width: 56px; height: 30px; border-radius: 15px; display: flex; align-items: center; justify-content: center; }
.m-nav-item.on { color: var(--gray-900); }
.m-nav-item.on .m-nav-ic { background: var(--primary-light); }

/* Drawer */
.m-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .32); z-index: 510; }
.m-drawer { position: fixed; top: 0; bottom: 0; left: 0; width: 290px; max-width: 84vw; z-index: 520; background: var(--surface); border-radius: 0 16px 16px 0; padding: 12px 12px calc(12px + env(safe-area-inset-bottom)); padding-top: calc(12px + env(safe-area-inset-top)); display: flex; flex-direction: column; gap: 2px; transform: translateX(-100%); transition: transform .2s ease; }
.m-drawer.open { transform: none; box-shadow: 0 4px 8px 3px rgba(60, 64, 67, .15), 0 1px 3px rgba(60, 64, 67, .3); }
.m-drawer-head { padding: 12px 16px 14px; font-size: 18px; font-weight: 500; color: var(--gray-900); }
.m-item { height: 52px; display: flex; align-items: center; gap: 14px; padding: 0 18px; border-radius: 26px; color: var(--gray-800); font-size: 15px; }
.m-item.on { background: var(--primary-light); color: var(--primary-on-light); font-weight: 600; }
.m-sep { height: 1px; background: var(--gray-200); margin: 6px 12px; }
