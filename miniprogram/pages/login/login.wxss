.login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
.login-box { width: 100%; background: var(--surface); border-radius: 28px; padding: 36px 24px 24px; border: 1px solid var(--gray-200); }
.login-head { text-align: center; margin-bottom: 20px; }
.login-logo { height: 44px; display: block; margin: 0 auto 4px; }
.login-sub { font-size: 15px; color: var(--gray-600); margin-top: 6px; }
.bind-tip { font-size: 13px; color: var(--gray-500); text-align: center; margin-bottom: 14px; }
.btn-lg { min-height: 48px; font-size: 16px; }
.switch { text-align: center; font-size: 14px; }
.link { color: var(--primary); }
