[Unit]
Description=CRP race backstage console (City Run Project)
After=network.target

[Service]
Type=simple
User=crp
Group=crp
WorkingDirectory=/opt/crp/server
Environment=NODE_ENV=production
Environment=PORT=80
Environment=DATA_DIR=/opt/crp/data
# Optional: host list and event name (only used on first initialization)
# Environment=HOST_USERNAMES=阳秋,云缨,云影
# Environment=EVENT_NAME=BJ20 全明星赛
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# Allow binding port 80 as non-root (install.sh sets cap_net_bind_service on node)
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
