[Unit]
Description=CRP 城市飞奔幕后指挥系统
After=network.target

[Service]
Type=simple
User=crp
Group=crp
WorkingDirectory=/opt/crp/server
Environment=NODE_ENV=production
Environment=PORT=80
Environment=DATA_DIR=/opt/crp/data
# 可选：固定主办名单与赛事名（只在首次初始化时生效）
# Environment=HOST_USERNAMES=阳秋,云缨,云影
# Environment=EVENT_NAME=BJ20 全明星赛
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# 允许非 root 用户监听 80 端口（install.sh 已为 node 设置 cap_net_bind_service）
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
